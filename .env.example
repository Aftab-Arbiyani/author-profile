FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
BLOG_ADMIN_SECRET=
# ARC reader program — generate with: openssl rand -hex 32
ARC_SESSION_SECRET=
# Manuscript leak attribution — generate with: openssl rand -hex 32.
# MUST be its own value, never a copy of ARC_SESSION_SECRET. Two reasons:
# rotating sessions (which merely signs readers out) would otherwise invalidate
# every existing watermark, and this key gets handled during a leak investigation
# where a session-signing key has no business being. There is no fallback — the
# invisible watermark is skipped entirely when this is unset. (The visible
# on-screen watermark needs no secret and applies either way.)
ARC_WATERMARK_SECRET=
# Resend (transactional email for ARC magic links + notices)
RESEND_API_KEY=
# Optional: verified sender, e.g. "Aftab Arbiyani <arc@aftabarbiyani.com>"
EMAIL_FROM=
# Optional: where author notifications (new applications/reviews) are sent
ARC_NOTIFY_EMAIL=
